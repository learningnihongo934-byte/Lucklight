{
  // Lucklight: static game (public/) + leaderboard Durable Object. ./build.sh deploy
  "name": "lucklight",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "BOARD", "class_name": "Board" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }],
  // lucklight.rennko.tech/* is more specific than Rennko Cloud's *.rennko.tech/* route, so this host stays here
  "routes": [{ "pattern": "lucklight.rennko.tech", "custom_domain": true }, { "pattern": "lucklight.rennko.tech/*", "zone_name": "rennko.tech" }],
  "workers_dev": true
}
